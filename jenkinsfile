pipeline {
    agent any

    environment {
        APP_PATH = '/var/lib/jenkins/workspace/CICD PIPELINE ML PROJECT'
        VENV_PATH = 'venv/bin/activate'
        STREAMLIT_PORT = '8501'
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code from GitHub...'
                checkout scm
            }
        }

        stage('Initialize') {
            steps {
                echo 'Initializing Python virtual environment and installing dependencies...'
                sh '''
                cd ${APP_PATH}
                
                if [ ! -d "venv" ]; then
                    python3 -m venv venv
                fi

                source ${VENV_PATH}
                pip install --upgrade pip
                pip install -r requirements.txt
                '''
            }
        }

        stage('Build and Deploy') {
            steps {
                echo 'Starting Movie Recommender System Application...'
                sh '''
                cd ${APP_PATH}
                source ${VENV_PATH}
                nohup streamlit run app.py --server.port=${STREAMLIT_PORT} &
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline Completed'
        }

        success {
            script {
                def publicIP = sh(script: "curl -s http://checkip.amazonaws.com", returnStdout: true).trim()
                echo "✅ Movie Recommender System is running at: http://${publicIP}:${STREAMLIT_PORT}"
            }
        }

        failure {
            echo '❌ Pipeline failed. Check the logs for details.'
        }
    }
}
